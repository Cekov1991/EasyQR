APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Which mailer in config/mail.php delivers mail. Unset means `log`: mail is
# written to laravel.log and never sent, which is the default for local work.
# Anything that must really deliver has to name its mailer here.
#   smtp     — generic SMTP, reads the MAIL_* variables below (Resend, etc.)
#   mailtrap — reads MAILTRAP_*, not MAIL_*
#   brevo    — reads BREVO_*, not MAIL_*
#   resend   — Resend's HTTP API, reads RESEND_KEY. Needs resend/resend-php,
#              which is NOT installed; use MAIL_MAILER=smtp for Resend instead.
MAIL_MAILER=log

# Only read when MAIL_MAILER=smtp. For Resend over SMTP the username is the
# literal string `resend` and the password is the API key.
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
# Must be an address on a domain verified with the sending provider, or every
# send is rejected no matter how the credentials are set. Leaving either of these
# unset is not harmless: mail then goes out from a domain we do not own, signed
# with the placeholder name from config/mail.php.
MAIL_FROM_ADDRESS="support@easy-qr-code.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only read when MAIL_MAILER=mailtrap / brevo / resend respectively.
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
BREVO_USERNAME=
BREVO_PASSWORD=
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AgentaOS — payments (merchant of record).
# Secret key from app.agentaos.ai -> Settings -> Developers -> API Keys.
# The prefix is the environment: sk_test_... is sandbox, sk_live_... is real
# money and requires business verification to have been approved first.
AGENTAOS_API_KEY=
# Signing secret from Developer -> Webhooks, used to verify inbound webhooks.
# Without it every webhook is rejected and no payment is ever credited.
AGENTAOS_WEBHOOK_SECRET=
# UUIDs of the subscription payment links, one per plan. The amount and
# interval are fixed on the link when it is created, so a price change means
# recreating the link and swapping the id. Create the yearly one per
# environment with: php artisan agentaos:create-payment-link
# The monthly link is not yet buyable and cannot yet be created by the command.
AGENTAOS_MONTHLY_PAYMENT_LINK_ID=
AGENTAOS_YEARLY_PAYMENT_LINK_ID=
AGENTAOS_BASE_URL=https://api.agentaos.ai/api/v1

# Subscription — all optional, these are the defaults.
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_DEFAULT_PLAN=yearly
SUBSCRIPTION_MONTHLY_PRICE=5.90
SUBSCRIPTION_YEARLY_PRICE=49
SUBSCRIPTION_CURRENCY=USD
SUBSCRIPTION_DYNAMIC_QR_LIMIT=5
SUBSCRIPTION_STATIC_QR_LIMIT=50

# Where billing failures are emailed. Blank logs without emailing, which means
# a payment taken without access granted is only found by reading logs.
BILLING_ALERT_EMAIL=
BILLING_ALERT_THROTTLE_MINUTES=60

# Live subscriptions allowed to vanish from one AgentaOS listing before
# billing:sync stops closing them and alerts instead. Zero disables the cap.
SUBSCRIPTION_MAX_MISSING_PER_SYNC=10
